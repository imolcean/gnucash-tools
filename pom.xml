<?xml version="1.0" encoding="UTF-8"?>
<project child.project.url.inherit.append.path="false" xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>org.duckdns.gory26</groupId>
    <artifactId>gnucash-tools-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>gnucash-tools</name>
    <description>Adapters and tooling for GnuCash: the SQL book, a phone front end, and desktop reports</description>
    <!-- Own url, scm and licence instead of the ones inherited from spring-boot-starter-parent; modules keep them
         as they are (the attributes stop Maven from appending the module name). -->
    <url>https://github.com/imolcean/gnucash-tools</url>
    <scm child.scm.url.inherit.append.path="false">
        <url>https://github.com/imolcean/gnucash-tools</url>
    </scm>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/license/mit</url>
        </license>
    </licenses>

    <modules>
        <module>gnucash-book</module>
        <module>gnucash-togo</module>
        <module>gnucash-reports</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <!-- Overrides of Boot-managed versions to pick up CVE fixes; drop once Boot catches up. -->
        <jackson-bom.version>3.1.8</jackson-bom.version>
        <logback.version>1.6.6</logback.version>
        <json-smart.version>2.6.1</json-smart.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jmolecules</groupId>
                <artifactId>jmolecules-bom</artifactId>
                <version>2025.0.2</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Same ArchUnit version jmolecules-starter-test brings in. -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>1.4.1</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <!-- ./mvnw verify -P fast: skips the tests tagged "docker" (Testcontainers), so it runs without Docker. -->
        <profile>
            <id>fast</id>
            <properties>
                <excludedGroups>docker</excludedGroups>
            </properties>
        </profile>
    </profiles>

    <!-- gnucash-book goes to GitHub Packages on a tag gnucash-book/v1.2.3, with a flattened pom that does not need this one
         (.github/workflows/gnucash-book-publish.yml, ADR-0013). -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/imolcean/gnucash-tools</url>
        </repository>
    </distributionManagement>

</project>
