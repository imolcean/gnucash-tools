<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>org.duckdns.gory26</groupId>
    <artifactId>fincore-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>fincore</name>
    <description>Fincore domain model; adapters and tooling for GnuCash, Portfolio Performance, etc.</description>

    <modules>
        <module>fincore-core</module>
        <module>gnucash-book</module>
        <module>gnucash-togo</module>
        <module>gnucash-reports</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <!-- Overrides of Boot-managed versions to pick up CVE fixes; drop once Boot catches up. -->
        <jackson-bom.version>3.1.8</jackson-bom.version>
        <logback.version>1.6.6</logback.version>
        <json-smart.version>2.6.1</json-smart.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.jmolecules</groupId>
                <artifactId>jmolecules-bom</artifactId>
                <version>2025.0.2</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Same ArchUnit version jmolecules-starter-test brings into fincore-core. -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>1.4.1</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
